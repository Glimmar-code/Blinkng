# Blinkng staging / preview environment template
# Copy values into your local/CI secret store. Do NOT commit privileged secrets.

BLINK_ENV=staging

# Supabase preview/staging public client values.
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_OR_ANON_KEY

# Public share endpoint used by Android staging builds.
BLINK_SHARE_BASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co/functions/v1/blink-web

# Never put service-role or sb_secret_* keys in Android/Windows client configuration.
