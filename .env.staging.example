# Blinkng staging / preview environment template
# Copy values into your local/CI secret store. Do NOT commit real secrets.

BLINK_ENV=staging

# Supabase preview/staging project values.
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_STAGING_PUBLISHABLE_KEY

# Public share-preview endpoint for staging builds.
BLINK_SHARE_PREVIEW_BASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co/functions/v1/share-preview

# Never put service-role or sb_secret_* keys in Android/Windows client configuration.
