-- Minimal disposable schema for the discovery timeout migration contract.
-- Contains no production data or credentials.
create schema if not exists private_ranking;

do $roles$
begin
  create role anon nologin;
exception when duplicate_object then null;
end;
$roles$;
do $roles$
begin
  create role authenticated nologin;
exception when duplicate_object then null;
end;
$roles$;

create table public.blocks (
  blocker_id uuid not null,
  blocked_id uuid not null
);
create table public.post_views (
  viewer_id uuid not null,
  post_id uuid not null,
  last_viewed_at timestamptz not null default now()
);
create table public.post_likes (
  user_id uuid not null,
  post_id uuid not null,
  created_at timestamptz not null default now()
);
create table public.post_bookmarks (
  user_id uuid not null,
  post_id uuid not null,
  created_at timestamptz not null default now()
);
create table public.comments (
  author_id uuid not null,
  post_id uuid not null,
  created_at timestamptz not null default now()
);
create table public.feed_posts (id uuid primary key);

create type public.notification_type_enum as enum ('system');
create table public.profiles (
  id uuid primary key,
  blink_vip_until timestamptz
);
create table public.notifications (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null,
  type public.notification_type_enum not null,
  text text,
  sub_text text,
  is_read boolean not null default false
);
create table public.blink_inventory (
  id uuid primary key default gen_random_uuid(),
  status text not null,
  expires_at timestamptz,
  updated_at timestamptz not null default now()
);
create table public.blink_boosts (
  id uuid primary key default gen_random_uuid(),
  status text not null,
  ends_at timestamptz not null
);
create table public.blink_vip_passes (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null,
  expires_at timestamptz not null,
  expiry_reminder_sent boolean not null default false
);

-- The primary key starts with user_id, so the post_id foreign key needs its own index.
create table public.feed_preferences (
  user_id uuid not null,
  post_id uuid not null references public.feed_posts(id),
  primary key(user_id, post_id)
);

create function public.market_seller_has_approval(p_seller_id uuid)
returns boolean language sql stable as $function$ select true $function$;
create table public.marketplace_listings (seller_id uuid);
create table public.marketplace_orders (seller_id uuid);
create function public.market_require_approved_seller()
returns trigger language plpgsql security definer as $function$
begin
  if not public.market_seller_has_approval(new.seller_id) then raise exception 'MARKET_SELLER_APPROVAL_REQUIRED'; end if;
  return new;
end;
$function$;
create function public.market_require_approved_seller_for_order()
returns trigger language plpgsql security definer as $function$
begin
  if not public.market_seller_has_approval(new.seller_id) then raise exception 'MARKET_SELLER_APPROVAL_REQUIRED'; end if;
  return new;
end;
$function$;
create trigger market_require_approved_seller_trigger
before insert or update on public.marketplace_listings
for each row execute function public.market_require_approved_seller();
create trigger market_require_approved_seller_for_order_trigger
before insert or update on public.marketplace_orders
for each row execute function public.market_require_approved_seller_for_order();

create function public.record_content_view(p_post_id uuid, p_event_id uuid)
returns void language plpgsql as $function$
begin
  perform 1 from public.feed_posts where id=p_post_id for key share;
end;
$function$;

create function private_ranking.get_discovery_feed(
  p_limit integer default 40,
  p_offset integer default 0,
  p_as_of timestamptz default now(),
  p_gravity numeric default 1.5,
  p_w1 numeric default 2.0,
  p_w2 numeric default 1.0,
  p_w3 numeric default 250.0,
  p_w4 numeric default 4.0
)
returns table(
  item jsonb,
  feed_score numeric,
  ranking_components jsonb,
  feed_position integer,
  as_of timestamptz,
  next_offset integer
)
language plpgsql
set search_path = ''
as $function$
declare
  v_position integer;
  v_target_count integer := 1;
begin
  create temporary table discovery_candidates (
    post_id uuid primary key,
    creator_id uuid not null,
    is_reel boolean not null,
    creator_tier text not null,
    feed_score numeric not null,
    created_at timestamptz not null
  ) on commit drop;

  for v_position in 1..v_target_count loop
    exit;
  end loop;
  return;
end;
$function$;
