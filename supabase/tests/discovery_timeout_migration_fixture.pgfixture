-- Minimal disposable schema for the discovery timeout migration contract.
-- Contains no production data or credentials.
create schema if not exists private_ranking;
create schema if not exists private;

do $roles$
begin
  create role anon nologin;
exception when duplicate_object then null;
end;
$roles$;
do $roles$
begin
  create role authenticated nologin;
exception when duplicate_object then null;
end;
$roles$;
do $roles$
begin
  create role service_role nologin;
exception when duplicate_object then null;
end;
$roles$;

create table public.blocks (
  blocker_id uuid not null,
  blocked_id uuid not null
);
create table public.post_views (
  viewer_id uuid not null,
  post_id uuid not null,
  last_viewed_at timestamptz not null default now()
);
create table public.post_likes (
  user_id uuid not null,
  post_id uuid not null,
  created_at timestamptz not null default now()
);
create table public.post_bookmarks (
  user_id uuid not null,
  post_id uuid not null,
  created_at timestamptz not null default now()
);
create table public.comments (
  author_id uuid not null,
  post_id uuid not null,
  created_at timestamptz not null default now()
);
create table public.feed_posts (id uuid primary key);
create table public.fk_parent (id uuid primary key);
create table public.category_parent (slug text primary key);

create type public.notification_type_enum as enum ('system');
create table public.profiles (
  id uuid primary key,
  blink_vip_until timestamptz,
  points bigint not null default 0,
  updated_at timestamptz not null default now()
);
create table public.point_transactions (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references public.profiles(id),
  action_type text not null,
  points_delta integer not null,
  reference_id uuid,
  created_at timestamptz not null default now()
);
create unique index point_transactions_reference_unique
  on public.point_transactions(user_id,action_type,reference_id)
  where reference_id is not null;

create table public.messages (
  id uuid primary key default gen_random_uuid(),
  sender_id uuid not null references public.profiles(id),
  content text not null default ''
);
create index messages_sender_idx on public.messages(sender_id);

create function public.award_points(p_user_id uuid, p_action_type text, p_reference_id uuid default null)
returns integer
language plpgsql
security definer
set search_path = ''
as $function$
declare
  v_tx_id uuid;
  v_points bigint;
begin
  insert into public.point_transactions(user_id,action_type,points_delta,reference_id)
  values(p_user_id,p_action_type,5,p_reference_id)
  on conflict (user_id,action_type,reference_id)
  where reference_id is not null
  do nothing
  returning id into v_tx_id;

  if v_tx_id is null then
    select points into v_points from public.profiles where id=p_user_id;
    return coalesce(v_points,0)::integer;
  end if;

  update public.profiles
  set points=coalesce(points,0)+5, updated_at=now()
  where id=p_user_id
  returning points into v_points;
  return coalesce(v_points,0)::integer;
end;
$function$;

create function public.award_message_points()
returns trigger
language plpgsql
security definer
as $function$
begin
  perform public.award_points(new.sender_id,'message_user',null);
  return new;
end;
$function$;
create trigger trg_points_message
after insert on public.messages
for each row execute function public.award_message_points();

create table public.notifications (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null,
  type public.notification_type_enum not null,
  text text,
  sub_text text,
  is_read boolean not null default false
);
create table public.blink_inventory (
  id uuid primary key default gen_random_uuid(),
  status text not null,
  expires_at timestamptz,
  updated_at timestamptz not null default now()
);
create table public.blink_boosts (
  id uuid primary key default gen_random_uuid(),
  content_id uuid references public.fk_parent(id),
  status text not null,
  ends_at timestamptz not null
);
create index blink_boosts_content_active_idx
  on public.blink_boosts(content_id,ends_at) where status='ACTIVE';

create table private.blink_paystack_renewals (
  user_id uuid not null references public.fk_parent(id),
  status text not null
);
create unique index blink_paystack_one_open_renewal_per_user
  on private.blink_paystack_renewals(user_id)
  where status in ('creating','active','cancel_pending');

create table public.blink_contest_entry_appeals (
  contest_id uuid not null references public.fk_parent(id),
  status text not null,
  created_at timestamptz not null default now()
);
create index blink_contest_appeals_pending_idx
  on public.blink_contest_entry_appeals(contest_id,created_at desc)
  where status='pending';

create table public.blink_referrals (
  referrer_user_id uuid not null references public.fk_parent(id),
  status text not null,
  confirmed_at timestamptz
);
create index blink_referrals_referrer_idx
  on public.blink_referrals(referrer_user_id,confirmed_at desc)
  where status='confirmed';

create table public.blink_vip_claims (
  user_id uuid not null references public.fk_parent(id),
  claim_key text not null,
  claim_date date
);
create unique index blink_vip_daily_claim_unique
  on public.blink_vip_claims(user_id,claim_key,claim_date)
  where claim_date is not null;

create table public.connect_listings (
  category_slug text references public.category_parent(slug),
  is_active boolean not null default true,
  created_at timestamptz not null default now()
);
create index idx_connect_listings_category_live_newest
  on public.connect_listings(category_slug,created_at desc)
  where is_active=true;

create table public.mentor_requests (
  mentor_profile_id uuid not null references public.fk_parent(id),
  requester_id uuid not null,
  status text not null
);
create unique index mentor_requests_pending_uidx
  on public.mentor_requests(mentor_profile_id,requester_id)
  where status='pending';

create table public.reading_mate_requests (
  reading_profile_id uuid not null references public.fk_parent(id),
  requester_id uuid not null,
  status text not null
);
create unique index reading_mate_requests_pending_uidx
  on public.reading_mate_requests(reading_profile_id,requester_id)
  where status='pending';

create table public.blink_vip_passes (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null,
  expires_at timestamptz not null,
  expiry_reminder_sent boolean not null default false
);

-- The primary key starts with user_id, so the post_id foreign key needs its own index.
create table public.feed_preferences (
  user_id uuid not null,
  post_id uuid not null references public.feed_posts(id),
  primary key(user_id, post_id)
);

create function public.market_seller_has_approval(p_seller_id uuid)
returns boolean language sql stable as $function$ select true $function$;
create table public.marketplace_listings (seller_id uuid);
create table public.marketplace_orders (seller_id uuid);
create function public.market_require_approved_seller()
returns trigger language plpgsql security definer as $function$
begin
  if not public.market_seller_has_approval(new.seller_id) then raise exception 'MARKET_SELLER_APPROVAL_REQUIRED'; end if;
  return new;
end;
$function$;
create function public.market_require_approved_seller_for_order()
returns trigger language plpgsql security definer as $function$
begin
  if not public.market_seller_has_approval(new.seller_id) then raise exception 'MARKET_SELLER_APPROVAL_REQUIRED'; end if;
  return new;
end;
$function$;
create trigger market_require_approved_seller_trigger
before insert or update on public.marketplace_listings
for each row execute function public.market_require_approved_seller();
create trigger market_require_approved_seller_for_order_trigger
before insert or update on public.marketplace_orders
for each row execute function public.market_require_approved_seller_for_order();

create function public.record_content_view(p_post_id uuid, p_event_id uuid)
returns void language plpgsql as $function$
begin
  perform 1 from public.feed_posts where id=p_post_id for key share;
end;
$function$;

create function private_ranking.get_discovery_feed(
  p_limit integer default 40,
  p_offset integer default 0,
  p_as_of timestamptz default now(),
  p_gravity numeric default 1.5,
  p_w1 numeric default 2.0,
  p_w2 numeric default 1.0,
  p_w3 numeric default 250.0,
  p_w4 numeric default 4.0
)
returns table(
  item jsonb,
  feed_score numeric,
  ranking_components jsonb,
  feed_position integer,
  as_of timestamptz,
  next_offset integer
)
language plpgsql
set search_path = ''
as $function$
declare
  v_position integer;
  v_target_count integer := 1;
begin
  create temporary table discovery_candidates (
    post_id uuid primary key,
    creator_id uuid not null,
    is_reel boolean not null,
    creator_tier text not null,
    feed_score numeric not null,
    created_at timestamptz not null
  ) on commit drop;

  for v_position in 1..v_target_count loop
    exit;
  end loop;
  return;
end;
$function$;
