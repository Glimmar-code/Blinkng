-- Disposable local prerequisites, never a production migration. Real Supabase Auth/Storage are retained.
create schema if not exists private;
create type public.notification_type_enum as enum ('system');
create table public.notifications(
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references auth.users(id),
  actor_id uuid references auth.users(id),
  type public.notification_type_enum not null,
  target_type text,target_id uuid,text text,sub_text text,
  is_read boolean not null default false,
  metadata jsonb not null default '{}'::jsonb,
  created_at timestamptz not null default now()
);
create table public.profiles(
  id uuid primary key references auth.users(id),
  username text,full_name text,avatar_url text,university text
);

create table private.local_fixture_admins(id uuid primary key references auth.users(id));
revoke all on table private.local_fixture_admins from public,anon,authenticated;
create function private.require_blink_admin() returns uuid language plpgsql security definer set search_path='' as $$
begin
  if not exists(select 1 from private.local_fixture_admins where id=auth.uid()) then
    raise exception 'ADMIN_REQUIRED' using errcode='42501';
  end if;
  return auth.uid();
end; $$;
revoke all on function private.require_blink_admin() from public,anon,authenticated;
alter table public.notifications enable row level security;
grant select on public.notifications to authenticated;
create policy fixture_own_notifications on public.notifications for select to authenticated using(user_id=auth.uid());
alter publication supabase_realtime add table public.notifications;
create table public.conversations(id uuid primary key,is_group boolean not null default false);
create table public.conversation_participants(conversation_id uuid references public.conversations(id),user_id uuid references public.profiles(id),left_at timestamptz,primary key(conversation_id,user_id));
create table public.blocks(blocker_id uuid,blocked_id uuid,primary key(blocker_id,blocked_id));
create table public.messages(id uuid primary key,conversation_id uuid references public.conversations(id),sender_id uuid references public.profiles(id),content text,media_url text,message_type text not null default 'text',deleted_for_everyone boolean not null default false,created_at timestamptz not null default now(),image_album_id uuid,image_album_position integer,image_album_size integer);
create table public.feed_posts(id uuid primary key,audience text default 'Everyone');
create table public.polls(id uuid primary key,expires_at timestamptz);
create table public.poll_options(id uuid primary key,poll_id uuid references public.polls(id));
create table public.poll_votes(id uuid primary key,poll_id uuid references public.polls(id),option_id uuid references public.poll_options(id),user_id uuid);
grant select on public.polls,public.poll_options to authenticated;
grant select,insert on public.poll_votes,public.feed_posts to authenticated;
