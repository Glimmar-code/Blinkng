-- Synthetic additions to the referral integration fixture, never a production migration.
create table public.feed_posts (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references public.profiles(id),
  is_reel boolean not null default true,
  is_active boolean not null default true,
  is_flagged boolean not null default false,
  audience text not null default 'Everyone',
  video_url text,
  image_url text,
  images text[] not null default '{}',
  caption text,
  text text,
  view_count integer not null default 0,
  like_count integer not null default 0,
  comment_count integer not null default 0,
  share_count integer not null default 0,
  expires_at timestamptz,
  created_at timestamptz not null default now()
);
create table private.content_view_events (
  event_id uuid primary key default gen_random_uuid(),
  viewer_id uuid not null,
  post_id uuid not null references public.feed_posts(id),
  content_type text not null,
  view_weight smallint not null,
  created_at timestamptz not null default now()
);
create table public.messages (
  id uuid primary key default gen_random_uuid(),
  conversation_id uuid not null references public.conversations(id),
  sender_id uuid not null references auth.users(id),
  content text not null,
  message_type text not null default 'text',
  created_at timestamptz not null default now()
);
grant select on public.feed_posts to authenticated;
create or replace function public.send_message(p_receiver_username text,p_content text)
returns uuid language plpgsql security definer set search_path='' as $$
declare
  v_recipient uuid;
  v_conversation uuid;
  v_message uuid;
  v_sender uuid := auth.uid();
begin
  if v_sender is null then raise exception 'AUTHENTICATION_REQUIRED'; end if;
  select id into v_recipient from public.profiles
  where username=lower(btrim(p_receiver_username)) limit 1;
  if v_recipient is null or v_recipient=v_sender then raise exception 'INVALID_RECIPIENT'; end if;
  insert into public.conversations(created_by,is_group)
  values(v_sender,false) returning id into v_conversation;
  insert into public.conversation_participants(conversation_id,user_id)
  values(v_conversation,v_sender),(v_conversation,v_recipient);
  insert into public.messages(conversation_id,sender_id,content)
  values(v_conversation,v_sender,p_content) returning id into v_message;
  return v_message;
end;
$$;
create or replace function public.send_group_message(p_conversation_id uuid,p_content text)
returns uuid language plpgsql security definer set search_path='' as $$
declare
  v_message uuid;
begin
  if not exists (
    select 1 from public.conversation_participants
    where conversation_id=p_conversation_id and user_id=auth.uid()
  ) then raise exception 'NOT_A_GROUP_MEMBER'; end if;
  insert into public.messages(conversation_id,sender_id,content)
  values(p_conversation_id,auth.uid(),p_content) returning id into v_message;
  return v_message;
end;
$$;

