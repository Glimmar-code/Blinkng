values (
 '00000000-0000-0000-0000-000000000004','2026-01-03T00:00:00Z',
 '{"blink_referrer_id":"00000000-0000-0000-0000-000000000003"}'
);
do $$
begin
  if exists (select 1 from public.blink_referrals
             where referred_user_id in (
              '00000000-0000-0000-0000-000000000003',
              '00000000-0000-0000-0000-000000000004'
             ))
  then raise exception 'Self or unonboarded referral accepted'; end if;
end $$;

-- Public suggestions protect private profiles, rank exact username first.
insert into auth.users(id,created_at,email_confirmed_at)
values ('00000000-0000-0000-0000-000000000005','2025-01-02T00:00:00Z',now());
insert into public.profiles(id,username,full_name,university,onboarding_completed)
values ('00000000-0000-0000-0000-000000000005','alphaprivate','Alpha Private','FUTA',true);
insert into public.user_settings(user_id,private_account)
values ('00000000-0000-0000-0000-000000000005',true);
do $$
declare first_username text;
begin
  select username into first_username from public.blink_referrer_suggestions('alpha',10,0) limit 1;
  if first_username <> 'alpha'
  then raise exception 'Exact referrer match not ranked first: %', first_username; end if;
  if exists(select 1 from public.blink_referrer_suggestions('alpha',10,0) where username='alphaprivate')
  then raise exception 'Private user was leaked in public signup suggestions'; end if;
end $$;

-- Logged-in referrer sees exactly one confirmed referral and active discovery score.
select set_config('request.jwt.claim.sub','00000000-0000-0000-0000-000000000001',false);
do $$
declare total bigint; active bigint; points integer;
begin
  select total_referrals,active_referrals,visibility_points into total,active,points
  from public.blink_referral_dashboard();
  if total<>1 or active<>1 or points<>3
  then raise exception 'Dashboard totals invalid: %, %, %',total,active,points; end if;
  if exists(select 1 from public.blink_referral_recommendations(10) where id='00000000-0000-0000-0000-000000000001')
  then raise exception 'Self-profile suggested to viewer'; end if;
end $$;

-- Fresh referrals fade smoothly, never rewrite historical achievement counts.
update public.blink_referrals
  set confirmed_at=now()-interval '11 days'
  where referred_user_id='00000000-0000-0000-0000-000000000002';
do $$
declare total bigint; points integer; badge text;
begin
  select total_referrals, visibility_points, achievement_tier into total, points, badge
  from public.blink_referral_dashboard();
  if total<>1 or points<>2 or badge<>'Starter'
  then raise exception 'Day 11 fade must retain permanent achievement: %, %, %',total,points,badge; end if;
end $$;

update public.blink_referrals
  set confirmed_at=now()-interval '21 days'
  where referred_user_id='00000000-0000-0000-0000-000000000002';
do $$
declare total bigint; points integer;
begin
  select total_referrals, visibility_points into total, points from public.blink_referral_dashboard();
  if total<>1 or points<>1
  then raise exception 'Day 21 must have 1 point and still 1 lifelong referral: %, %', total, points; end if;
end $$;

update public.blink_referrals
  set confirmed_at=now()-interval '31 days'
  where referred_user_id='00000000-0000-0000-0000-000000000002';
do $$
declare total bigint; active bigint; points integer; badge text;
begin
  select total_referrals, active_referrals, visibility_points, achievement_tier
  into total, active, points, badge from public.blink_referral_dashboard();
  if total<>1 or active<>0 or points<>0 or badge<>'Starter'
  then raise exception 'Day 31 expiry cannot erase badge: %, %, %, %',total,active,points,badge; end if;
end $$;

