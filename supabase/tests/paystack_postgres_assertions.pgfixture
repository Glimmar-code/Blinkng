-- Apply only after disposable fixture and the candidate migration.
select set_config('request.jwt.claim.sub','11111111-1111-4111-8111-111111111111',false);

-- Server-side pricing is fixed even if the client attempts to choose arbitrary values.
select public.create_blink_paystack_order('verification','BLUE');
select public.create_blink_paystack_order('coin_pack','coins_500');

do $$
declare v_blue public.blink_paystack_payments%rowtype;
        v_coin public.blink_paystack_payments%rowtype;
        v_user uuid := '11111111-1111-4111-8111-111111111111';
begin
 select * into v_blue from public.blink_paystack_payments
  where user_id=v_user and item_code='BLUE';
 select * into v_coin from public.blink_paystack_payments
  where user_id=v_user and purchase_kind='coin_pack';
 if v_blue.amount_ngn <> 800 or v_blue.currency <> 'NGN' or v_blue.duration_days <> 30 then
   raise exception 'BLUE_SERVER_PRICE_INVALID';
 end if;
 if v_coin.amount_ngn <> 500 or v_coin.coin_amount <> 550 then
   raise exception 'COIN_SERVER_PRICE_INVALID';
 end if;
 if has_function_privilege('authenticated','public.fulfill_blink_paystack_order(text,text,bigint,text)','EXECUTE') then
   raise exception 'PAYMENT_FULFILLMENT_EXPOSED_TO_CLIENT';
 end if;
 if has_function_privilege('anon','public.fulfill_blink_paystack_order(text,text,bigint,text)','EXECUTE') then
   raise exception 'PAYMENT_FULFILLMENT_EXPOSED_TO_ANON';
 end if;
 if not has_function_privilege('service_role','public.fulfill_blink_paystack_order(text,text,bigint,text)','EXECUTE') then
   raise exception 'SERVICE_CANNOT_FULFILL';
 end if;
 if not (select relrowsecurity from pg_class where oid='public.blink_paystack_payments'::regclass) then
   raise exception 'LEDGER_RLS_NOT_ENABLED';
 end if;
end $$;

-- Emulate the trusted, server-verified Paystack acknowledgement.
set role service_role;
do $$
declare
 v_blue public.blink_paystack_payments%rowtype;
 v_coin public.blink_paystack_payments%rowtype;
 v_value jsonb;
begin
 select * into v_blue from public.blink_paystack_payments where item_code='BLUE';
 select * into v_coin from public.blink_paystack_payments where purchase_kind='coin_pack';
 -- Reject an underpayment, before any entitlements can be credited.
 begin
   perform public.fulfill_blink_paystack_order(v_coin.reference,'test-paystack-tx-1',49900,'NGN');
   raise exception 'UNDERPAYMENT_WAS_ACCEPTED';
 exception when others then
   if sqlerrm='UNDERPAYMENT_WAS_ACCEPTED' then raise; end if;
 end;
 v_value := public.fulfill_blink_paystack_order(v_coin.reference,'test-paystack-tx-1',50000,'NGN');
 if v_value->>'status' <> 'fulfilled' or coalesce((v_value->>'already_fulfilled')::boolean,true) then
   raise exception 'COIN_NOT_FULFILLED';
 end if;
 v_value := public.fulfill_blink_paystack_order(v_coin.reference,'test-paystack-tx-1',50000,'NGN');
 if not (v_value->>'already_fulfilled')::boolean then
   raise exception 'COIN_DUPLICATE_NOT_RECOGNIZED';
 end if;
 if (select credited from public.blink_coin_test_credits where user_id=v_coin.user_id) <> 550 then
   raise exception 'DUPLICATE_COIN_CREDIT';
 end if;
 begin
   perform public.fulfill_blink_paystack_order(v_blue.reference,'test-paystack-tx-1',80000,'NGN');
   raise exception 'DUPLICATE_PROVIDER_TX_ACCEPTED';
 exception when unique_violation then
   null;
 end;
 v_value := public.fulfill_blink_paystack_order(v_blue.reference,'test-paystack-tx-2',80000,'NGN');
 if v_value->>'status' <> 'fulfilled' then raise exception 'BLUE_NOT_FULFILLED'; end if;
 if (select verification_badge from public.profiles where id=v_blue.user_id) <> 'BLUE' then
   raise exception 'BLUE_BADGE_NOT_ACTIVATED';
 end if;
 if (select verification_expires_at from public.profiles where id=v_blue.user_id) <= now() then
   raise exception 'BLUE_BADGE_EXPIRY_INVALID';
 end if;
end $$;
reset role;

-- Regression: BLUE order created first, then user earns active GOLD.
-- Gold users are normally blocked from NEW Blue orders, but an older
-- pending Blue receipt can settle after the upgrade.
select public.create_blink_paystack_order('verification','BLUE');
update public.profiles
set verification_badge='GOLD',
    verification_tier='Gold',
    verification_expires_at=now()+interval '60 days'
where id='11111111-1111-4111-8111-111111111111';
set role service_role;
do $paystack_guard$
declare v_order public.blink_paystack_payments%rowtype;
        v_expiry timestamptz;
begin
 select verification_expires_at into v_expiry from public.profiles
 where id='11111111-1111-4111-8111-111111111111';
 select * into v_order from public.blink_paystack_payments
 where item_code='BLUE' and status='pending' order by created_at desc limit 1;
 perform public.fulfill_blink_paystack_order(v_order.reference,'test-paystack-tx-3',80000,'NGN');
 if (select verification_badge from public.profiles where id=v_order.user_id) <> 'GOLD'
   or (select verification_expires_at from public.profiles where id=v_order.user_id)
      is distinct from v_expiry then
   raise exception 'BLUE_EXTENDED_OR_DOWNGRADED_ACTIVE_GOLD';
 end if;
end $paystack_guard$;
reset role;

-- Regression: a pending BLUE receipt must not make permanent GOLD expire.
-- Create while BLUE, then grant GOLD before settling the older order.
update public.profiles set verification_badge='BLUE',
    verification_tier='Standard', verification_expires_at=now()+interval '30 days'
where id='11111111-1111-4111-8111-111111111111';
select public.create_blink_paystack_order('verification','BLUE');
update public.profiles set verification_badge='GOLD',
    verification_tier='Gold', verification_expires_at=null
where id='11111111-1111-4111-8111-111111111111';
set role service_role;
do $paystack_guard$
declare v_order public.blink_paystack_payments%rowtype;
begin
 select * into v_order from public.blink_paystack_payments
 where item_code='BLUE' and status='pending' order by created_at desc limit 1;
 perform public.fulfill_blink_paystack_order(v_order.reference,'test-paystack-tx-4',80000,'NGN');
 if (select verification_badge from public.profiles where id=v_order.user_id) <> 'GOLD'
   or (select verification_expires_at from public.profiles where id=v_order.user_id)
      is not null then
   raise exception 'BLUE_EXPIRED_OR_DOWNGRADED_PERMANENT_GOLD';
 end if;
end $paystack_guard$;
reset role;
-- Additional one-time plan, RLS, finance and notification tests.
UPDATE public.profiles SET verification_badge='BLUE',
 verification_tier='Standard',verification_expires_at=now()+interval '30 days'
WHERE id='11111111-1111-4111-8111-111111111111';

DO $plan_rejections$
BEGIN
  BEGIN
    PERFORM public.create_blink_paystack_order_v2('verification','BLUE',2);
    RAISE EXCEPTION 'INVALID_MONTHS_ACCEPTED';
  EXCEPTION WHEN others THEN
    IF sqlerrm='INVALID_MONTHS_ACCEPTED' THEN RAISE; END IF;
  END;
  BEGIN
    PERFORM public.create_blink_paystack_order_v2('coin_pack','coins_500',3);
    RAISE EXCEPTION 'RECURRING_COIN_PACK_ACCEPTED';
  EXCEPTION WHEN others THEN
    IF sqlerrm='RECURRING_COIN_PACK_ACCEPTED' THEN RAISE; END IF;
  END;
END
$plan_rejections$;

SELECT public.create_blink_paystack_order_v2('verification','BLUE',3);
SELECT public.create_blink_paystack_order_v2('verification','BLUE',6);
SELECT public.create_blink_paystack_order_v2('verification','BLUE',12);
DO $discount_assertions$
DECLARE v_user uuid:='11111111-1111-4111-8111-111111111111';
BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.blink_paystack_payments
 WHERE user_id=v_user AND item_code='BLUE' AND duration_days=90 AND amount_ngn=2160)
 THEN RAISE EXCEPTION 'THREE_MONTH_DISCOUNT_INVALID'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.blink_paystack_payments
 WHERE user_id=v_user AND item_code='BLUE' AND duration_days=180 AND amount_ngn=3840)
 THEN RAISE EXCEPTION 'SIX_MONTH_DISCOUNT_INVALID'; END IF;
 IF NOT EXISTS(SELECT 1 FROM public.blink_paystack_payments
 WHERE user_id=v_user AND item_code='BLUE' AND duration_days=365 AND duration_months=12 AND amount_ngn=6720)
 THEN RAISE EXCEPTION 'TWELVE_MONTH_DISCOUNT_INVALID'; END IF;
 IF has_function_privilege('authenticated',
  'public.blink_paystack_financial_report(timestamptz,timestamptz)','EXECUTE')
 THEN RAISE EXCEPTION 'REVENUE_EXPOSED_TO_CUSTOMER'; END IF;
 IF has_function_privilege('anon',
  'public.blink_paystack_financial_report(timestamptz,timestamptz)','EXECUTE')
 THEN RAISE EXCEPTION 'REVENUE_EXPOSED_TO_ANON'; END IF;
END
$discount_assertions$;

-- GOLD eligibility and 3-month discount must be checked by the database.
INSERT INTO public.follows(follower_id,following_id)
SELECT '11111111-1111-4111-8111-111111111111',
'11111111-1111-4111-8111-111111111111'
FROM generate_series(1,1000);
SELECT public.create_blink_paystack_order_v2('verification','GOLD',3);
DO $gold_discount$
BEGIN
 IF NOT EXISTS(SELECT 1 FROM public.blink_paystack_payments
 WHERE item_code='GOLD' AND duration_days=90 AND amount_ngn=5400)
 THEN RAISE EXCEPTION 'GOLD_DISCOUNT_INVALID'; END IF;
END
$gold_discount$;

SET ROLE service_role;
DO $paid_plan_once$
DECLARE v_payment public.blink_paystack_payments%rowtype;
        v_result jsonb;
        v_before timestamptz;
BEGIN
 SELECT * INTO v_payment FROM public.blink_paystack_payments
 WHERE duration_days=90 AND item_code='BLUE' ORDER BY created_at DESC LIMIT 1;
 SELECT verification_expires_at INTO v_before FROM public.profiles
 WHERE id=v_payment.user_id;
 v_result:=public.fulfill_blink_paystack_order(
   v_payment.reference,'test-paystack-multimonth-blue',216000,'NGN');
 IF v_result->>'status' <> 'fulfilled'
 THEN RAISE EXCEPTION 'THREE_MONTH_NOT_GRANTED'; END IF;
 IF (SELECT verification_expires_at FROM public.profiles
 WHERE id=v_payment.user_id) < v_before+interval '89 days'
 THEN RAISE EXCEPTION 'THREE_MONTH_EXPIRY_SHORT'; END IF;
 PERFORM public.fulfill_blink_paystack_order(
   v_payment.reference,'test-paystack-multimonth-blue',216000,'NGN');
 IF (SELECT count(*) FROM private.blink_paystack_notification_outbox
 WHERE payment_id=v_payment.id) <> 1
 THEN RAISE EXCEPTION 'DUPLICATE_PAYMENT_NOTIFICATION'; END IF;
END
$paid_plan_once$;
RESET ROLE;

-- Owner-only receipt RPC must not show another user's purchase.
INSERT INTO public.profiles(id) VALUES
('22222222-2222-4222-8222-222222222222');
INSERT INTO public.blink_paystack_payments
(user_id,reference,purchase_kind,item_code,amount_ngn,duration_days)
VALUES('22222222-2222-4222-8222-222222222222',
'blink-ps-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa','verification','BLUE',800,30);
SET ROLE authenticated;
DO $receipt_rls$
DECLARE v_receipts jsonb;
BEGIN
 v_receipts:=public.get_my_blink_paystack_receipts(100);
 IF jsonb_array_length(v_receipts)<5 THEN
   RAISE EXCEPTION 'MISSING_PAYMENT_RECEIPTS';
 END IF;
 IF EXISTS(SELECT 1 FROM jsonb_array_elements(v_receipts) rec
 WHERE rec->>'reference'='blink-ps-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa')
 THEN RAISE EXCEPTION 'OTHER_USERS_RECEIPT_LEAKED'; END IF;
END
$receipt_rls$;
RESET ROLE;
SET ROLE service_role;
SELECT public.blink_paystack_financial_report(now()-interval '1 day',now()+interval '1 day');
RESET ROLE;

-- Signed provider events are server-only, idempotent and auditable.
DO $event_authorization$
BEGIN
 IF has_function_privilege('authenticated',
   'public.record_blink_paystack_provider_event(text,text,text,bigint,text)','EXECUTE')
 THEN RAISE EXCEPTION 'PROVIDER_EVENT_WRITABLE_BY_CUSTOMER'; END IF;
END
$event_authorization$;
SET ROLE service_role;
DO $provider_events$
DECLARE v_payment public.blink_paystack_payments%rowtype;
BEGIN
 SELECT * INTO v_payment FROM public.blink_paystack_payments
 WHERE item_code='BLUE' AND duration_days=90 AND status='fulfilled'
 LIMIT 1;
 PERFORM public.record_blink_paystack_provider_event(
 v_payment.reference,'charge.dispute.create','test-dispute-once',216000,'NGN');
 PERFORM public.record_blink_paystack_provider_event(
 v_payment.reference,'charge.dispute.create','test-dispute-once',216000,'NGN');
 IF (SELECT count(*) FROM private.blink_paystack_provider_events
 WHERE event_key='test-dispute-once')<>1 THEN
 RAISE EXCEPTION 'DUPLICATE_DISPUTE_EVENT'; END IF;
 PERFORM public.record_blink_paystack_provider_event(
 v_payment.reference,'refund.processed','test-refund-once',216000,'NGN');
 IF (SELECT status FROM public.blink_paystack_payments
 WHERE id=v_payment.id)<>'refunded' THEN
 RAISE EXCEPTION 'PROVIDER_REFUND_NOT_RECORDED'; END IF;
END
$provider_events$;
RESET ROLE;

-- Regression: no unapproved paid boost rate can create a charge.
DO $rate_guard$
BEGIN
 BEGIN
  PERFORM public.create_blink_paystack_boost_order(
   'POST','33333333-3333-4333-8333-333333333333',25,
   'VIEWS','MY_UNIVERSITY',3,null);
  RAISE EXCEPTION 'CASH_BOOST_ACCEPTED_WITHOUT_PRICE_APPROVAL';
 EXCEPTION WHEN others THEN
  IF sqlerrm='CASH_BOOST_ACCEPTED_WITHOUT_PRICE_APPROVAL' THEN RAISE; END IF;
 END;
END
$rate_guard$;

-- Earlier fixtures intentionally created many orders; move their timestamps
-- outside the genuine rate-limit window before exercising a *new* boost order.
UPDATE public.blink_paystack_payments
SET created_at=created_at-interval '2 hours'
WHERE user_id='11111111-1111-4111-8111-111111111111';
UPDATE private.blink_economy_config SET int_value=1
 WHERE key='paystack_boost_naira_per_coin';
SELECT public.create_blink_paystack_boost_order(
 'POST','33333333-3333-4333-8333-333333333333',25,
 'VIEWS','MY_UNIVERSITY',3,null);
SET ROLE service_role;
DO $boost_paid_once$
DECLARE v_payment public.blink_paystack_payments%rowtype;
 v_first jsonb; v_second jsonb;
BEGIN
 SELECT * INTO v_payment FROM public.blink_paystack_payments
  WHERE purchase_kind='boost' LIMIT 1;
 IF v_payment.amount_ngn<>100 THEN RAISE EXCEPTION 'BOOST_QUOTE_MISMATCH'; END IF;
 BEGIN
  PERFORM public.fulfill_blink_paystack_order(
   v_payment.reference,'tx-cash-boost',9900,'NGN');
  RAISE EXCEPTION 'UNDERPAID_BOOST_GRANTED';
 EXCEPTION WHEN others THEN
  IF sqlerrm='UNDERPAID_BOOST_GRANTED' THEN RAISE; END IF;
 END;
 v_first:=public.fulfill_blink_paystack_order(
   v_payment.reference,'tx-cash-boost',10000,'NGN');
 v_second:=public.fulfill_blink_paystack_order(
   v_payment.reference,'tx-cash-boost',10000,'NGN');
 IF v_first->>'status'<>'fulfilled'
 OR coalesce((v_second->>'already_fulfilled')::boolean,false)=false
 OR (SELECT count(*) FROM public.blink_boost_campaigns_v2
     WHERE user_id=v_payment.user_id)<>1
 THEN RAISE EXCEPTION 'DUPLICATE_OR_MISSING_CASH_CAMPAIGN'; END IF;
END
$boost_paid_once$;

-- Re-enrollment cannot silently bind someone else's paid verification.
UPDATE public.profiles SET verification_badge='BLUE',verification_tier='Standard',
 verification_expires_at=now()+interval '40 days'
WHERE id='11111111-1111-4111-8111-111111111111';
DO $recurring_consent_test$
DECLARE v_id uuid; v_expiry timestamptz;
 v_payment public.blink_paystack_payments%rowtype;v_data jsonb;v_second jsonb;
BEGIN
 SELECT * INTO v_payment FROM public.blink_paystack_payments
 WHERE user_id='11111111-1111-4111-8111-111111111111'
  AND item_code='BLUE' AND status='fulfilled'
 ORDER BY created_at LIMIT 1;
 BEGIN
  PERFORM public.prepare_blink_paystack_renewal(v_payment.user_id,
   v_payment.reference,'PLN_test001','CUS_test001','wrong-consent');
  RAISE EXCEPTION 'SILENT_RENEWAL_CONSENT_ACCEPTED';
 EXCEPTION WHEN others THEN
  IF sqlerrm='SILENT_RENEWAL_CONSENT_ACCEPTED' THEN RAISE; END IF;
 END;
 v_data:=public.prepare_blink_paystack_renewal(v_payment.user_id,
   v_payment.reference,'PLN_test001','CUS_test001','v1.2026-10');
 v_id:=(v_data->>'id')::uuid;
 PERFORM public.finish_blink_paystack_renewal(
  v_id,'SUB_testsubscription01','emailtoken123456');
 SELECT verification_expires_at INTO v_expiry FROM public.profiles WHERE id=v_payment.user_id;

 -- A provider assertion with an underpaid amount must never extend membership.
 BEGIN
  PERFORM public.fulfill_blink_paystack_renewal(
   'SUB_testsubscription01','paystack-renewal-underpaid','renewal-tx-underpaid',79900,'NGN');
  RAISE EXCEPTION 'UNDERPAID_RENEWAL_ACCEPTED';
 EXCEPTION WHEN others THEN
  IF sqlerrm <> 'RENEWAL_PAYMENT_MISMATCH' THEN RAISE; END IF;
 END;
 v_data:=public.fulfill_blink_paystack_renewal(
  'SUB_testsubscription01','paystack-renewal-001','renewal-tx-001',80000,'NGN');
 v_second:=public.fulfill_blink_paystack_renewal(
  'SUB_testsubscription01','paystack-renewal-001','renewal-tx-001',80000,'NGN');
 IF v_data->>'status'<>'fulfilled'
 OR (v_second->>'already_fulfilled')::boolean IS DISTINCT FROM true
 OR (SELECT verification_expires_at FROM public.profiles WHERE id=v_payment.user_id)
    < v_expiry+interval '28 days'
 THEN RAISE EXCEPTION 'RENEWAL_NOT_FULFILLED_ONCE'; END IF;
 IF NOT public.stop_blink_paystack_renewal(v_id,v_payment.user_id) THEN
  RAISE EXCEPTION 'CANCELLATION_FAILED'; END IF;
 IF (SELECT status FROM private.blink_paystack_renewals WHERE id=v_id)<>'cancelled'
 THEN RAISE EXCEPTION 'SUBSCRIPTION_STILL_ACTIVE'; END IF;
 IF has_function_privilege('authenticated',
  'public.fulfill_blink_paystack_renewal(text,text,text,bigint,text)','EXECUTE')
 THEN RAISE EXCEPTION 'CUSTOMER_CAN_FORGE_RENEWAL'; END IF;
END
$recurring_consent_test$;

-- SIMULATION ONLY: cancellation blocks further grant even if a later invoice is replayed.
-- Existing paid expiration remains unchanged; no Paystack calls or live users involved.
DO $cancelled_renewal_regression$
DECLARE v_sub uuid; v_expiry timestamptz; v_count bigint;
 v_user uuid:='11111111-1111-4111-8111-111111111111';
BEGIN
 SELECT id INTO v_sub FROM private.blink_paystack_renewals
 WHERE subscription_code='SUB_testsubscription01';
 IF v_sub IS NULL THEN RAISE EXCEPTION 'MISSING_SIMULATED_SUBSCRIPTION'; END IF;
 SELECT verification_expires_at INTO v_expiry FROM public.profiles WHERE id=v_user;
 SELECT count(*) INTO v_count FROM public.blink_paystack_payments
 WHERE user_id=v_user AND paystack_transaction_id LIKE 'renewal-tx-%';
 IF public.stop_blink_paystack_renewal(v_sub,v_user) THEN
   RAISE EXCEPTION 'CANCELLATION_WAS_NOT_IDEMPOTENT';
 END IF;
 IF public.stop_blink_paystack_renewal(v_sub,'22222222-2222-4222-8222-222222222222') THEN
   RAISE EXCEPTION 'OTHER_USER_CANCELLATION_ACCEPTED';
 END IF;
 BEGIN
  PERFORM public.fulfill_blink_paystack_renewal(
   'SUB_testsubscription01','paystack-renewal-after-cancel',
   'renewal-tx-after-cancel',80000,'NGN');
  RAISE EXCEPTION 'CANCELLED_RENEWAL_GRANTED';
 EXCEPTION WHEN others THEN
  IF sqlerrm <> 'SUBSCRIPTION_NOT_ACTIVE' THEN RAISE; END IF;
 END;
 IF (SELECT verification_expires_at FROM public.profiles WHERE id=v_user)
    IS DISTINCT FROM v_expiry
   OR (SELECT count(*) FROM public.blink_paystack_payments
       WHERE user_id=v_user AND paystack_transaction_id LIKE 'renewal-tx-%') <> v_count
 THEN RAISE EXCEPTION 'CANCELLED_RENEWAL_CHANGED_BENEFITS'; END IF;
END
$cancelled_renewal_regression$;

-- Cancellation notification is queued once and the queue stays service-only.
DO $cancel_notice_regression$
DECLARE v_prior bigint; v_notice uuid; v_batch jsonb;
BEGIN
 SELECT count(*) INTO v_prior FROM private.blink_paystack_notification_outbox;
 PERFORM public.queue_blink_paystack_renewal_notice(
   'SUB_testsubscription01','renewal_cancelled','cancelled:SIMULATED_SUB_001');
 PERFORM public.queue_blink_paystack_renewal_notice(
   'SUB_testsubscription01','renewal_cancelled','cancelled:SIMULATED_SUB_001');
 IF (SELECT count(*) FROM private.blink_paystack_notification_outbox) <> v_prior+1
 THEN RAISE EXCEPTION 'DUPLICATE_CANCELLATION_NOTICE_QUEUED'; END IF;
 SELECT id INTO v_notice FROM private.blink_paystack_notification_outbox
 WHERE event_key='cancelled:SIMULATED_SUB_001';
 v_batch:=public.claim_blink_paystack_payment_notices(25);
 IF NOT EXISTS(SELECT 1 FROM jsonb_array_elements(v_batch) x
   WHERE x->>'id'=v_notice::text)
 THEN RAISE EXCEPTION 'CANCELLATION_NOTICE_NOT_CLAIMED'; END IF;
 IF NOT public.complete_blink_paystack_payment_notice(
    v_notice,'failed','SIMULATED_BREVO_REJECTED')
 THEN RAISE EXCEPTION 'FAILED_EMAIL_NOT_RECORDED'; END IF;
 IF (SELECT status FROM private.blink_paystack_notification_outbox
     WHERE id=v_notice)<>'failed'
 THEN RAISE EXCEPTION 'FAILED_EMAIL_QUEUE_STATE_INVALID'; END IF;
 IF has_function_privilege('authenticated',
   'public.queue_blink_paystack_renewal_notice(text,text,text)','EXECUTE')
 THEN RAISE EXCEPTION 'CUSTOMER_CAN_FORGE_RENEWAL_NOTICES'; END IF;
END
$cancel_notice_regression$;

DO $email_claim_test$
DECLARE v_claimed jsonb;v_first jsonb;
BEGIN
 v_claimed:=public.claim_blink_paystack_payment_notices(25);
 IF jsonb_array_length(v_claimed)<2 THEN
  RAISE EXCEPTION 'MISSING_TRANSACTION_EMAILS'; END IF;
 PERFORM public.complete_blink_paystack_payment_notice(
   (v_claimed->0->>'id')::uuid,'sent',null);
 v_first:=public.claim_blink_paystack_payment_notices(25);
 IF EXISTS(SELECT 1 FROM jsonb_array_elements(v_first) x
     WHERE x->>'id'=v_claimed->0->>'id')
 THEN RAISE EXCEPTION 'DUPLICATE_PAYMENT_EMAIL_SEND'; END IF;
 IF has_function_privilege('authenticated',
    'public.claim_blink_paystack_payment_notices(integer)','EXECUTE')
 THEN RAISE EXCEPTION 'CUSTOMER_CAN_SEND_EMAIL'; END IF;
END
$email_claim_test$;
RESET ROLE;
-- Final assertion: webhook replay/confirmation cannot credit twice.
select 'BLINK Paystack disposable PostgreSQL integration passed' as result;
