-- Disposable PostgreSQL only. No credentials or personal production data.
create role anon nologin;
create role authenticated nologin;
create role service_role nologin;
create schema auth;
create schema storage;
create schema private;
create schema extensions;
create schema net;
create extension if not exists pgcrypto with schema extensions;
create function net.http_post(url text,body jsonb default '{}'::jsonb,headers jsonb default '{}'::jsonb,timeout_milliseconds integer default 5000) returns bigint language sql as 'select 1::bigint';
create or replace function auth.uid() returns uuid
language sql stable set search_path='' as $$
 select nullif(current_setting('request.jwt.claim.sub', true),'')::uuid
$$;
create table auth.users(id uuid primary key);
create type public.notification_type_enum as enum ('system');
create table public.notification_push_dispatches (
 notification_id uuid primary key,
 status text not null check(status in ('sending','sent','failed')),
 attempts integer not null default 1,
 updated_at timestamptz not null default now(),
 last_error text
);
create table public.notifications (
 id uuid primary key default gen_random_uuid(),
 user_id uuid references auth.users(id),
 actor_id uuid references auth.users(id),
 type public.notification_type_enum not null,
 target_type text,
 target_id uuid,
 text text, sub_text text,
 is_read boolean not null default false,
 created_at timestamptz not null default now(),
 metadata jsonb not null default '{}'::jsonb
);
create table public.blink_communities (
 id uuid primary key default gen_random_uuid(),
 owner_id uuid not null references auth.users(id),
 name text not null, description text not null default '',
 cover_url text, university text not null default 'FUTA',
 category text not null default 'Academic',
 visibility text not null default 'public' check(visibility in ('public','private')),
 rules text[] not null default '{}',
 created_at timestamptz not null default now(),
 updated_at timestamptz not null default now()
);
create table public.blink_community_members(
 community_id uuid references public.blink_communities(id) on delete cascade,
 user_id uuid references auth.users(id) on delete cascade,
 role text not null default 'member' check(role in ('member','moderator')),
 status text not null default 'active' check(status in ('invited','pending','active','banned')),
 joined_at timestamptz not null default now(),
 primary key(community_id,user_id)
);
create table storage.buckets(
 id text primary key,name text not null,public boolean not null default false,
 file_size_limit bigint,allowed_mime_types text[]
);
create table storage.objects(
 id uuid primary key default gen_random_uuid(),
 bucket_id text references storage.buckets(id),
 name text not null unique
);
grant usage on schema public,storage,auth to authenticated,anon;
grant select on public.blink_communities to authenticated;
grant select on public.blink_community_members to authenticated;
grant insert,select on storage.objects to authenticated;
alter table public.blink_communities enable row level security;
alter table public.blink_community_members enable row level security;
create policy blink_communities_select on public.blink_communities
 for select to authenticated using (
   visibility='public' or owner_id=(select auth.uid()) or
   exists(select 1 from public.blink_community_members m where
     m.community_id=id and m.user_id=(select auth.uid()) and m.status='active')
 );
-- Read-what-is-mine only; followers must not list other followers.
create policy blink_community_members_read on public.blink_community_members
 for select to authenticated using(user_id=(select auth.uid()));

