-- CI-only, disposable PostgreSQL fixture. No real users, credentials or remote database.
-- PostgreSQL roles are cluster-wide even when test databases are isolated.
do $fixture_roles$
begin
  if not exists (select 1 from pg_roles where rolname='anon') then
    create role anon nologin;
  end if;
  if not exists (select 1 from pg_roles where rolname='authenticated') then
    create role authenticated nologin;
  end if;
  if not exists (select 1 from pg_roles where rolname='service_role') then
    create role service_role nologin;
  end if;
end;
$fixture_roles$;
create schema auth;

create function auth.uid() returns uuid language sql stable as
$$ select nullif(current_setting('request.jwt.claim.sub', true),'')::uuid $$;

create table public.profiles (
  id uuid primary key
);
create table public.user_balances (
  user_id uuid primary key references public.profiles(id),
  spendable_coin_balance numeric not null default 0,
  updated_at timestamptz not null default now()
);
create table public.game_profiles (
  user_id uuid primary key references public.profiles(id),
  coins bigint not null default 0,
  updated_at timestamptz not null default now()
);
create table public.blink_coin_gifts (
  id uuid primary key default gen_random_uuid(),
  sender_id uuid not null references public.profiles(id),
  receiver_id uuid not null references public.profiles(id),
  amount bigint not null,
  created_at timestamptz not null default now()
);
-- Reproduce production's sender-freeze BEFORE INSERT guard in disposable CI.
create schema private;
create table private.admin_user_controls (
  user_id uuid primary key,
  coin_frozen boolean not null default false
);
create function private.guard_coin_transfer_admin_controls() returns trigger
language plpgsql security definer set search_path to ''
as $guard$
begin
  if new.sender_id is not null and exists (
    select 1 from private.admin_user_controls c
    where c.user_id = new.sender_id and c.coin_frozen
  ) then
    raise exception 'COIN_BALANCE_FROZEN';
  end if;
  return new;
end;
$guard$;
create trigger trg_admin_guard_coin_gifts
before insert on public.blink_coin_gifts
for each row execute function private.guard_coin_transfer_admin_controls();

create type public.notification_type_enum as enum ('tip','system');
create table public.notifications (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references public.profiles(id),
  actor_id uuid references public.profiles(id),
  type public.notification_type_enum not null,
  text text,
  sub_text text,
  target_type text,
  target_id uuid,
  metadata jsonb not null default '{}'::jsonb
);

