# Blinkng production environment template
# Real values belong in local/CI secret stores, never in this file.

BLINK_ENV=production

SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY

BLINK_SHARE_PREVIEW_BASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co/functions/v1/share-preview

# Production service-role / secret keys must stay server-side only and must never be bundled in Android or Windows clients.
