# Blinkng production environment template
# Real values belong in local/CI configuration, never privileged secrets in source.

BLINK_ENV=production

SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PRODUCTION_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PRODUCTION_PUBLISHABLE_OR_ANON_KEY

BLINK_SHARE_BASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co/functions/v1/blink-web

# Production service-role / secret keys must stay server-side only and must never be bundled in Android or Windows clients.
