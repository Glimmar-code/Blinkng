<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ always shows a system splash window before the first app frame.
         Override the default launcher icon so startup shows only Blink branding. -->
    <style name="Theme.MyApplication" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/blink_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_b</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

</resources>
